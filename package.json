{
  "name": "forum-hq-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Forum HQ - private debate team portal on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply forum-hq-db --local",
    "db:remote": "wrangler d1 migrations apply forum-hq-db --remote",
    "admin:local": "node scripts/set-admin-password.mjs --local",
    "admin:remote": "node scripts/set-admin-password.mjs --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.33.1"
  }
}
